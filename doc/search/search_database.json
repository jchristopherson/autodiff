tent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_le_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_le_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical","tags":"","url":"interface\\operator(lt=).html"},{"title":"operator(==) – AUTODIFF","text":"public interface operator(==) Value-only equality. Module Procedures private pure function hd_eq(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_eq_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_eq_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical","tags":"","url":"interface\\operator(==).html"},{"title":"operator(>) – AUTODIFF","text":"public interface operator(>) Value-only greater-than comparison. Module Procedures private pure function hd_gt(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_gt_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_gt_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical","tags":"","url":"interface\\operator(gt).html"},{"title":"operator(>=) – AUTODIFF","text":"public interface operator(>=) Value-only greater-than-or-equal comparison. Module Procedures private pure function hd_ge(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_ge_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_ge_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical","tags":"","url":"interface\\operator(gt=).html"},{"title":"sign – AUTODIFF","text":"public interface sign Magnitude of the first operand with the sign of the second. Module Procedures private pure function hd_sign(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_sign_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_sign_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual )","tags":"","url":"interface\\sign.html"},{"title":"sin – AUTODIFF","text":"public interface sin Sine function. Module Procedures private pure function hd_sin(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\sin.html"},{"title":"sinh – AUTODIFF","text":"public interface sinh Hyperbolic sine function. Module Procedures private pure function hd_sinh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\sinh.html"},{"title":"sqrt – AUTODIFF","text":"public interface sqrt Square root of a positive value. Module Procedures private pure function hd_sqrt(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\sqrt.html"},{"title":"tan – AUTODIFF","text":"public interface tan Tangent function. Module Procedures private pure function hd_tan(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\tan.html"},{"title":"tanh – AUTODIFF","text":"public interface tanh Hyperbolic tangent function. Module Procedures private pure function hd_tanh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\tanh.html"},{"title":"abs – AUTODIFF","text":"public interface abs Absolute value; the derivative at zero is defined to be zero. Module Procedures private elemental function ad_abs(a) result(c) Propagate sign(a)*da, choosing derivative zero at a = 0. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\abs~2.html"},{"title":"acos – AUTODIFF","text":"public interface acos Inverse cosine in radians; the active derivative is singular at +/-1. Module Procedures private elemental function ad_acos(a) result(c) Propagate -da/sqrt(1-a**2) using the inverse-sine derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\acos~2.html"},{"title":"acosh – AUTODIFF","text":"public interface acosh Inverse hyperbolic cosine for values >= 1; active derivative singular at 1. Module Procedures private elemental function ad_acosh(a) result(c) Propagate da/(sqrt(a-1)*sqrt(a+1)); inactive seeds stay zero at a = 1. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\acosh~2.html"},{"title":"asin – AUTODIFF","text":"public interface asin Inverse sine in radians; the active derivative is singular at +/-1. Module Procedures private elemental function ad_asin(a) result(c) Propagate da/sqrt(1-a**2), omitting the singular term for inactive seeds. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\asin~2.html"},{"title":"asinh – AUTODIFF","text":"public interface asinh Inverse hyperbolic sine. Module Procedures private elemental function ad_asinh(a) result(c) Propagate da/sqrt(a**2+1), using HYPOT to avoid overflow. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\asinh~2.html"},{"title":"assignment(=) – AUTODIFF","text":"public interface assignment(=) Copy AD data, assign a constant (clearing dx), or extract a real value. Module Procedures private elemental subroutine ad_assign_1(lhs, rhs) Copy the value and derivative of rhs to lhs. Arguments Type Intent Optional Attributes Name type( dual ), intent(out) :: lhs Output dual value and derivative produced by this operation. type( dual ), intent(in) :: rhs Input dual operand; its value and derivative participate in the documented operation. private elemental subroutine ad_assign_2(lhs, rhs) Assign a real64 constant rhs to lhs and clear its derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(out) :: lhs Output dual value and derivative produced by this operation. real(kind=real64), intent(in) :: rhs Input scalar operand or parameter used by the documented operation. private elemental subroutine ad_assign_3(lhs, rhs) Extract the value of rhs into real64 lhs, discarding the derivative. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out) :: lhs Output scalar receiving the computed value. type( dual ), intent(in) :: rhs Input dual operand; its value and derivative participate in the documented operation. private elemental subroutine ad_assign_integer(lhs, rhs) Assign a default-integer constant rhs to lhs and clear its derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(out) :: lhs Output dual value and derivative produced by this operation. integer, intent(in) :: rhs Input scalar operand or parameter used by the documented operation.","tags":"","url":"interface\\assignment(=)~2.html"},{"title":"atan – AUTODIFF","text":"public interface atan One- or two-argument inverse tangent in radians. Module Procedures private elemental function ad_atan(a) result(c) Propagate da/(1+a**2), using reciprocal scaling for large a. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_atan2(y, x) result(c) Propagate (x dy-y dx)/(x 2+y 2) using normalized coordinates. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: y Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: x Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_atan2_real(y, x) result(c) Evaluate ATAN2 with AD ordinate y and constant abscissa x. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: y Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: x Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_atan2_ad(y, x) result(c) Evaluate ATAN2 with constant ordinate y and AD abscissa x. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: y Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: x Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\atan~2.html"},{"title":"atan2 – AUTODIFF","text":"public interface atan2 Quadrant-aware inverse tangent ATAN2(y,x); not defined at the origin. Module Procedures private elemental function ad_atan2(y, x) result(c) Propagate (x dy-y dx)/(x 2+y 2) using normalized coordinates. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: y Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: x Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_atan2_real(y, x) result(c) Evaluate ATAN2 with AD ordinate y and constant abscissa x. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: y Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: x Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_atan2_ad(y, x) result(c) Evaluate ATAN2 with constant ordinate y and AD abscissa x. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: y Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: x Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\atan2~2.html"},{"title":"atanh – AUTODIFF","text":"public interface atanh Inverse hyperbolic tangent for values strictly between -1 and 1. Module Procedures private elemental function ad_atanh(a) result(c) Propagate da/(1-a**2) using factored divisions. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\atanh~2.html"},{"title":"cos – AUTODIFF","text":"public interface cos Cosine, with arguments in radians. Module Procedures private elemental function ad_cos(a) result(c) Propagate -sin(a)*da. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\cos~2.html"},{"title":"cosh – AUTODIFF","text":"public interface cosh Hyperbolic cosine. Module Procedures private elemental function ad_cosh(a) result(c) Propagate sinh(a)*da. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\cosh~2.html"},{"title":"erf – AUTODIFF","text":"public interface erf Error function. Module Procedures private elemental function ad_erf(a) result(c) Propagate 2/sqrt(pi) exp(-a 2) da. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\erf~2.html"},{"title":"erfc – AUTODIFF","text":"public interface erfc Complementary error function. Module Procedures private elemental function ad_erfc(a) result(c) Negate the error-function derivative for the complementary error function. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\erfc~2.html"},{"title":"exp – AUTODIFF","text":"public interface exp Natural exponential. Module Procedures private elemental function ad_exp(a) result(c) Propagate exp(a)*da. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\exp~2.html"},{"title":"log – AUTODIFF","text":"public interface log Natural logarithm for positive values. Module Procedures private elemental function ad_log(a) result(c) Propagate da/a for the natural logarithm. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\log~2.html"},{"title":"log10 – AUTODIFF","text":"public interface log10 Base-ten logarithm for positive values. Module Procedures private elemental function ad_log10(a) result(c) Propagate da/(a*log(10)) for the base-ten logarithm. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\log10~2.html"},{"title":"max – AUTODIFF","text":"public interface max Binary maximum, carrying the selected derivative; first argument wins ties. Module Procedures private elemental function ad_max(a, b) result(c) Return the higher-valued operand with its derivative, choosing a on a tie. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_max_real(a, b) result(c) Select the maximum of AD a and constant b; selecting b clears the derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_max_ad(a, b) result(c) Select the maximum of constant a and AD b; selecting a clears the derivative. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\max~2.html"},{"title":"min – AUTODIFF","text":"public interface min Binary minimum, carrying the selected derivative; first argument wins ties. Module Procedures private elemental function ad_min(a, b) result(c) Return the lower-valued operand with its derivative, choosing a on a tie. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_min_real(a, b) result(c) Select the minimum of AD a and constant b; selecting b clears the derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_min_ad(a, b) result(c) Select the minimum of constant a and AD b; selecting a clears the derivative. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\min~2.html"},{"title":"operator(*) – AUTODIFF","text":"public interface operator(*) Multiplication using the product rule. Module Procedures private elemental function ad_multiply(a, b) result(c) Apply the product rule: d(a b) = da b + a*db. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_multiply_real(a, b) result(c) Scale the value and derivative by a real64 constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_multiply_ad(a, b) result(c) Multiply a real64 constant by an AD operand. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_multiply_integer(a, b) result(c) Scale an AD operand by a default-integer constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function integer_multiply_ad(a, b) result(c) Multiply a default-integer constant by an AD operand. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\operator(ASTERISK)~2.html"},{"title":"operator(**) – AUTODIFF","text":"public interface operator(**) Exponentiation with constant or variable base/exponent.\nVariable exponents require a positive base, except that a zero constant\nbase with a positive exponent has zero derivative. Constant integral\nexponents also support negative bases. Module Procedures private elemental function ad_power(a, b) result(c) Apply d(a b) = b*a (b-1) da + a b log(a)*db.\nOmit inactive terms so constant powers work at zero and negative bases. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_power_real(a, b) result(c) Raise AD a to constant b with derivative b a (b-1) da.\nExponents zero and one are handled without singular intermediate powers. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_power_ad(a, b) result(c) Raise constant a to AD b with derivative a b log(a) db.\nA zero base and positive exponent give zero for both components. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_power_integer(a, b) result(c) Evaluate an integer power, preserving negative-base and zero-base behavior.\nNegative exponents avoid b-1, which could overflow the integer range. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function integer_power_ad(a, b) result(c) Raise a default-integer constant to an AD exponent using real64 arithmetic. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\operator(ASTERISKASTERISK)~2.html"},{"title":"operator(+) – AUTODIFF","text":"public interface operator(+) Unary identity and addition, including constant operands in either order. Module Procedures private elemental function ad_add(a, b) result(c) Add values and directional derivatives. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_add_real(a, b) result(c) Add a real64 constant without changing the derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function duald_ad(a, b) result(c) Add an AD operand to a real64 constant. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_add_integer(a, b) result(c) Add a default-integer constant using real64 arithmetic. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function integer_add_ad(a, b) result(c) Add an AD operand to a default-integer constant. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_positive(a) result(c) Unary plus preserves both components. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\operator(+)~2.html"},{"title":"operator(-) – AUTODIFF","text":"public interface operator(-) Unary negation and subtraction, including constant operands. Module Procedures private elemental function ad_subtract(a, b) result(c) Subtract values and directional derivatives. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_subtract_real(a, b) result(c) Subtract a real64 constant without changing the derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_subtract_ad(a, b) result(c) Subtract an AD operand from a real64 constant, negating its derivative. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_subtract_integer(a, b) result(c) Subtract a default-integer constant using real64 arithmetic. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function integer_subtract_ad(a, b) result(c) Subtract an AD operand from a default-integer constant. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_negative(a) result(c) Unary minus negates both components. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\operator(-)~2.html"},{"title":"operator(/) – AUTODIFF","text":"public interface operator(/) Division using the quotient rule; the denominator must be nonzero. Module Procedures private elemental function ad_divide(a, b) result(c) Apply the quotient rule as d(a/b) = (da - (a/b)*db)/b. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_divide_real(a, b) result(c) Divide the value and derivative by a nonzero real64 constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_divide_ad(a, b) result(c) Divide a real64 constant by AD b, with derivative -a db/b *2. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_divide_integer(a, b) result(c) Divide an AD operand by a nonzero default-integer constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function integer_divide_ad(a, b) result(c) Divide a default-integer constant by an AD operand. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\operator(SLASH)~2.html"},{"title":"operator(/=) – AUTODIFF","text":"public interface operator(/=) Inequality of values, independent of derivative seeds. Module Procedures private elemental function ad_not_equal(a, b) result(c) Compare only the values of two AD operands for inequality. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_not_equal_real(a, b) result(c) Compare an AD value with a real64 constant for inequality. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function real_not_equal_ad(a, b) result(c) Compare a real64 constant with an AD value for inequality. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_not_equal_integer(a, b) result(c) Compare an AD value with a default integer for inequality. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function integer_not_equal_ad(a, b) result(c) Compare a default integer with an AD value for inequality. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical","tags":"","url":"interface\\operator(SLASH=)~2.html"},{"title":"operator(<) – AUTODIFF","text":"public interface operator(<) Strict less-than comparison of values. Module Procedures private elemental function ad_less(a, b) result(c) Test whether AD a's value is strictly less than AD b's. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_less_real(a, b) result(c) Test whether an AD value is less than a real64 constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function real_less_ad(a, b) result(c) Test whether a real64 constant is less than an AD value. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_less_integer(a, b) result(c) Test whether an AD value is less than a default integer. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function integer_less_ad(a, b) result(c) Test whether a default integer is less than an AD value. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical","tags":"","url":"interface\\operator(lt)~2.html"},{"title":"operator(<=) – AUTODIFF","text":"public interface operator(<=) Less-than-or-equal comparison of values. Module Procedures private elemental function ad_less_equal(a, b) result(c) Test whether AD a's value is less than or equal to AD b's. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_less_equal_real(a, b) result(c) Test whether an AD value is at most a real64 constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function real_less_equal_ad(a, b) result(c) Test whether a real64 constant is at most an AD value. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_less_equal_integer(a, b) result(c) Test whether an AD value is at most a default integer. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function integer_less_equal_ad(a, b) result(c) Test whether a default integer is at most an AD value. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical","tags":"","url":"interface\\operator(lt=)~2.html"},{"title":"operator(==) – AUTODIFF","text":"public interface operator(==) Equality of values, independent of derivative seeds. Module Procedures private elemental function ad_equal(a, b) result(c) Compare only the values of two AD operands for equality. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_equal_real(a, b) result(c) Compare an AD value with a real64 constant for equality. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function real_equal_ad(a, b) result(c) Compare a real64 constant with an AD value for equality. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_equal_integer(a, b) result(c) Compare an AD value with a default integer for equality. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function integer_equal_ad(a, b) result(c) Compare a default integer with an AD value for equality. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical","tags":"","url":"interface\\operator(==)~2.html"},{"title":"operator(>) – AUTODIFF","text":"public interface operator(>) Strict greater-than comparison of values. Module Procedures private elemental function ad_greater(a, b) result(c) Test whether AD a's value is strictly greater than AD b's. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_greater_real(a, b) result(c) Test whether an AD value exceeds a real64 constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function real_greater_ad(a, b) result(c) Test whether a real64 constant exceeds an AD value. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_greater_integer(a, b) result(c) Test whether an AD value exceeds a default integer. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function integer_greater_ad(a, b) result(c) Test whether a default integer exceeds an AD value. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical","tags":"","url":"interface\\operator(gt)~2.html"},{"title":"operator(>=) – AUTODIFF","text":"public interface operator(>=) Greater-than-or-equal comparison of values. Module Procedures private elemental function ad_greater_equal(a, b) result(c) Test whether AD a's value is greater than or equal to AD b's. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_greater_equal_real(a, b) result(c) Test whether an AD value is at least a real64 constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function real_greater_equal_ad(a, b) result(c) Test whether a real64 constant is at least an AD value. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical private elemental function ad_greater_equal_integer(a, b) result(c) Test whether an AD value is at least a default integer. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. integer, intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value logical private elemental function integer_greater_equal_ad(a, b) result(c) Test whether a default integer is at least an AD value. Arguments Type Intent Optional Attributes Name integer, intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value logical","tags":"","url":"interface\\operator(gt=)~2.html"},{"title":"sign – AUTODIFF","text":"public interface sign Magnitude of a with the sign of b; ignores the derivative of b. Module Procedures private elemental function ad_sign(a, b) result(c) Propagate sign(1,b)*d(abs(a)), treating the sign selection as constant. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_sign_real(a, b) result(c) Apply a constant sign to AD a and its absolute-value derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. real(kind=real64), intent(in) :: b Input scalar operand or parameter used by the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function real_sign_ad(a, b) result(c) Apply AD b's sign to a constant magnitude, returning derivative zero. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a Input scalar operand or parameter used by the documented operation. type( dual ), intent(in) :: b Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\sign~2.html"},{"title":"sin – AUTODIFF","text":"public interface sin Sine, with arguments in radians. Module Procedures private elemental function ad_sin(a) result(c) Propagate cos(a)*da. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\sin~2.html"},{"title":"sinh – AUTODIFF","text":"public interface sinh Hyperbolic sine. Module Procedures private elemental function ad_sinh(a) result(c) Propagate cosh(a)*da. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\sinh~2.html"},{"title":"sqrt – AUTODIFF","text":"public interface sqrt Square root for nonnegative values; its active derivative is singular at zero. Module Procedures private elemental function ad_sqrt(a) result(c) Propagate da/(2*sqrt(a)); inactive seeds remain zero at a = 0. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\sqrt~2.html"},{"title":"tan – AUTODIFF","text":"public interface tan Tangent, with arguments in radians and away from its poles. Module Procedures private elemental function ad_tan(a) result(c) Propagate da/cos(a)**2. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\tan~2.html"},{"title":"tanh – AUTODIFF","text":"public interface tanh Hyperbolic tangent. Module Procedures private elemental function ad_tanh(a) result(c) Propagate da/cosh(a)**2 using exp(-abs(a)) to avoid hyperbolic overflow. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative.","tags":"","url":"interface\\tanh~2.html"},{"title":"autodiff_gradient – AUTODIFF","text":"Forward-mode evaluation of scalar-function gradients. Uses autodiff_interfaces autodiff_dual_numbers iso_fortran_env autodiff_workspace Subroutines public  subroutine gradient (fcn, x, g, work, args) Compute a scalar function's gradient by seeding one input direction \nat a time. Arguments Type Intent Optional Attributes Name procedure( scalar_function ) :: fcn User function whose result carries the value and seeded derivative. real(kind=real64), intent(in), dimension(:) :: x Point at which the gradient is evaluated. real(kind=real64), intent(out), dimension(:) :: g Gradient output, with one component per input; . class( workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure.","tags":"","url":"module\\autodiff_gradient.html"},{"title":"autodiff_hyperdual_workspace – AUTODIFF","text":"Reusable storage for hyper-dual-valued inputs. Uses iso_fortran_env autodiff_hyperdual_numbers Derived Types type, public :: hyperdual_workspace Allocatable temporary arrays used during second-order automatic\ndifferentiation. Components Type Visibility Attributes Name Initial type( hyperdual ), public, allocatable, dimension(:,:) :: xd_pool Per-thread hyper-dual-valued input buffers, one column per\nthread.  Serial evaluations use the first column. Type-Bound Procedures procedure, public :: resize => hwrk_resize Allocates or grows the workspace buffers. procedure, public :: validate_size => hwrk_validate_size Validates the size of the workspace.","tags":"","url":"module\\autodiff_hyperdual_workspace.html"},{"title":"autodiff_hessian – AUTODIFF","text":"Second-order forward-mode evaluation of scalar-function gradients and Hessians. Uses autodiff_interfaces iso_fortran_env autodiff_hyperdual_numbers autodiff_hyperdual_workspace Subroutines public  subroutine hessian (fcn, x, H, g, f, work, args, nthreads) Compute a scalar function's Hessian, and optionally its gradient and\nvalue, by seeding hyper-dual inputs.  The Hessian is symmetric and\nrequires evaluations of fcn ; the gradient and value\nare taken from the diagonal evaluations at no additional cost. Read more… Arguments Type Intent Optional Attributes Name procedure( hyperdual_function ) :: fcn User function whose result carries the value and derivatives. real(kind=real64), intent(in), dimension(:) :: x Point at which the Hessian is evaluated. real(kind=real64), intent(out), dimension(:,:) :: H Hessian output, . real(kind=real64), intent(out), optional, dimension(:) :: g Optional gradient output, . real(kind=real64), intent(out), optional :: f Optional function value at x . class( hyperdual_workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the function. integer, intent(in), optional :: nthreads The maximum number of threads to use when evaluating the\nHessian rows.  The default is 1 (serial). public  subroutine hvp (fcn, x, v, Hv, work, args) Evaluate the product of a scalar function's Hessian and a vector\nwithout forming the Hessian.  Each evaluation seeds the first\nderivative direction with v and the second with a unit vector,\nso the mixed derivative yields one component of .  This\nrequires size(x) evaluations of fcn . Arguments Type Intent Optional Attributes Name procedure( hyperdual_function ) :: fcn User function whose result carries the value and derivatives. real(kind=real64), intent(in), dimension(:) :: x Point at which the Hessian is evaluated. real(kind=real64), intent(in), dimension(:) :: v Direction vector with one component per input. real(kind=real64), intent(out), dimension(:) :: Hv Product of the Hessian and v, satisfying . class( hyperdual_workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the function.","tags":"","url":"module\\autodiff_hessian.html"},{"title":"autodiff_jvp – AUTODIFF","text":"Forward-mode evaluation of Jacobian-vector products. Uses autodiff_interfaces autodiff_dual_numbers iso_fortran_env autodiff_workspace Subroutines public  subroutine jvp (fcn, x, v, Jv, work, args) Evaluate the directional derivative of a vector function without \nforming its Jacobian. Arguments Type Intent Optional Attributes Name procedure( vector_function ) :: fcn User procedure that evaluates the vector-valued function. real(kind=real64), intent(in) :: x (:) Input point at which the directional derivative is evaluated. real(kind=real64), intent(in), dimension(:) :: v Direction vector, with one component per input; its entries seed \neach dual input. real(kind=real64), intent(out), dimension(:) :: Jv Product of the Jacobian and v, satisfying . class( workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure.","tags":"","url":"module\\autodiff_jvp.html"},{"title":"autodiff – AUTODIFF","text":"Uses autodiff_jvp autodiff_hyperdual_numbers autodiff_dual_numbers autodiff_hyperdual_workspace autodiff_hessian autodiff_interfaces autodiff_gradient autodiff_jacobian autodiff_workspace","tags":"","url":"module\\autodiff.html"},{"title":"autodiff_workspace – AUTODIFF","text":"Reusable storage for dual-valued inputs and outputs. Uses autodiff_dual_numbers iso_fortran_env Derived Types type, public :: workspace Allocatable temporary arrays used during automatic differentiation. Components Type Visibility Attributes Name Initial type( dual ), public, allocatable, dimension(:) :: fd Dual-valued function output buffer. type( dual ), public, allocatable, dimension(:,:) :: fd_pool Per-thread dual-valued function output buffers, one column per thread. type( dual ), public, allocatable, dimension(:) :: xd Dual-valued input buffer. type( dual ), public, allocatable, dimension(:,:) :: xd_pool Per-thread dual-valued input buffers, one column per thread. Type-Bound Procedures procedure, public :: resize => wrk_resize Allocates or grows the workspace buffers. procedure, public :: validate_size => wrk_validate_size Validates the size of the workspace.","tags":"","url":"module\\autodiff_workspace.html"},{"title":"autodiff_jacobian – AUTODIFF","text":"Forward-mode evaluation of vector-function Jacobian matrices. Uses autodiff_interfaces autodiff_dual_numbers iso_fortran_env autodiff_workspace Subroutines public  subroutine jacobian (fcn, x, J, work, args, nthreads) Compute a vector function's Jacobian by seeding each input basis \ndirection. Read more… Arguments Type Intent Optional Attributes Name procedure( vector_function ) :: fcn User procedure that evaluates the vector-valued function. real(kind=real64), intent(in), dimension(:) :: x Input point at which the Jacobian is evaluated. real(kind=real64), intent(out), dimension(:,:) :: J Jacobian output with shape (number of outputs, number of inputs); . class( workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure. integer, intent(in), optional :: nthreads The maximum number of threads to use when evaluating the\nJacobian columns.  The default is 1 (serial).","tags":"","url":"module\\autodiff_jacobian.html"},{"title":"autodiff_hyperdual_numbers – AUTODIFF","text":"Second-order forward-mode hyper-dual numbers and overloaded operations.\nHyper-dual number type carrying a value, two first derivatives, and a mixed second derivative.\nAssignment conversions between hyper-dual numbers and real or integer scalars.\nArithmetic operators propagating first and mixed second derivatives.\nComparisons use values only and ignore derivative seeds.\nRemaining value-only ordering comparisons.\nOverloaded real-valued intrinsic functions with second-order derivative propagation. Uses iso_fortran_env Interfaces public        interface abs Absolute value; the derivative at zero is taken as that of the positive branch. private pure function hd_abs(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface acos Inverse cosine function. private pure function hd_acos(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface acosh Inverse hyperbolic cosine function. private pure function hd_acosh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface asin Inverse sine function. private pure function hd_asin(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface asinh Inverse hyperbolic sine function. private pure function hd_asinh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface assignment(=) Copy hyper-dual data, assign a constant (clearing derivatives), or extract a real value. private pure subroutine hd_assign_hd(lhs, rhs) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(out) :: lhs type( hyperdual ), intent(in) :: rhs private pure subroutine hd_assign_real(lhs, rhs) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(out) :: lhs real(kind=real64), intent(in) :: rhs private pure subroutine hd_assign_integer(lhs, rhs) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(out) :: lhs integer, intent(in) :: rhs private pure subroutine real_assign_hd(lhs, rhs) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out) :: lhs type( hyperdual ), intent(in) :: rhs public        interface atan One- or two-argument inverse tangent function. private pure function hd_atan(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) private pure function hd_atan2(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual ) private pure function hd_atan2_real(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y real(kind=real64), intent(in) :: x Return Value type( hyperdual ) private pure function real_atan2_hd(y, x) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual ) public        interface atan2 Quadrant-aware inverse tangent with ordinate first. private pure function hd_atan2(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual ) private pure function hd_atan2_real(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y real(kind=real64), intent(in) :: x Return Value type( hyperdual ) private pure function real_atan2_hd(y, x) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual ) public        interface atanh Inverse hyperbolic tangent function. private pure function hd_atanh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface cos Cosine function. private pure function hd_cos(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface cosh Hyperbolic cosine function. private pure function hd_cosh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface erf Error function. private pure function hd_erf(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface erfc Complementary error function. private pure function hd_erfc(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface exp Exponential function. private pure function hd_exp(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface log Natural logarithm of a positive value. private pure function hd_log(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface log10 Base-ten logarithm of a positive value. private pure function hd_log10(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface max Maximum, carrying the selected operand's derivatives; ties choose the first. private pure function hd_max(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_max_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_max_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) public        interface min Minimum, carrying the selected operand's derivatives; ties choose the first. private pure function hd_min(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_min_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_min_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) public        interface operator(*) Multiplication using the product rule to second order. private pure function hd_multiply(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_multiply_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_multiply_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_multiply_integer(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a integer, intent(in) :: b Return Value type( hyperdual ) private pure function integer_multiply_hd(a, b) result(c) Arguments Type In