e Intent Optional Attributes Name integer, intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) public        interface operator(-) Subtraction and unary negation, including constant operands. private pure function hd_subtract(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_subtract_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_subtract_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_subtract_integer(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a integer, intent(in) :: b Return Value type( hyperdual ) private pure function integer_subtract_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name integer, intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_negative(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface operator(/) Division; the denominator must be nonzero. private pure function hd_divide(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_divide_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_divide_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_divide_integer(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a integer, intent(in) :: b Return Value type( hyperdual ) private pure function integer_divide_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name integer, intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) public        interface operator(/=) Value-only inequality. private pure function hd_ne(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_ne_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_ne_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical public        interface operator(<) Value-only less-than comparison. private pure function hd_lt(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_lt_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_lt_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical public        interface operator(<=) Value-only less-than-or-equal comparison. private pure function hd_le(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_le_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_le_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical public        interface operator(==) Value-only equality. private pure function hd_eq(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_eq_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_eq_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical public        interface operator(>) Value-only greater-than comparison. private pure function hd_gt(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_gt_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_gt_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical public        interface operator(>=) Value-only greater-than-or-equal comparison. private pure function hd_ge(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical private pure function hd_ge_real(a, b) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value logical private pure function real_ge_hd(a, b) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value logical public        interface sign Magnitude of the first operand with the sign of the second. private pure function hd_sign(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_sign_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_sign_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) public        interface sin Sine function. private pure function hd_sin(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface sinh Hyperbolic sine function. private pure function hd_sinh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface sqrt Square root of a positive value. private pure function hd_sqrt(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface tan Tangent function. private pure function hd_tan(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) public        interface tanh Hyperbolic tangent function. private pure function hd_tanh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) Derived Types type, public :: hyperdual A value, two directional derivatives, and their mixed second derivative.\nSeed dx and dy with one for each independent variable under study\nand zero otherwise. Components Type Visibility Attributes Name Initial real(kind=real64), public :: dx First derivative with respect to the first seed. real(kind=real64), public :: dxy Mixed second derivative with respect to both seeds. real(kind=real64), public :: dy First derivative with respect to the second seed. real(kind=real64), public :: x Function or independent-variable value.","tags":"","url":"module\\autodiff_hyperdual_numbers.html"},{"title":"autodiff_interfaces – AUTODIFF","text":"Abstract procedure interfaces used by the forward-mode differentiation routines. Uses iso_fortran_env Abstract Interfaces abstract interface public  function hyperdual_function(x, args) result(f) Evaluate a scalar function on hyper-dual inputs; the result's dx , dy , and dxy carry the seeded first and mixed second derivatives.\nProvides the hyper-dual argument and result type. Arguments Type Intent Optional Attributes Name type(hyperdual), intent(in), dimension(:) :: x Input values and derivative seeds. class(*), intent(in), optional :: args Optional caller-owned context passed to the function.  It is\nread-only from the function's perspective. Return Value type(hyperdual) Function value and derivatives. abstract interface public  function scalar_function(x, args) result(f) Evaluate a scalar function on dual inputs; the result's dx is \nthe seeded directional derivative.\nProvides the dual-number argument and result type. Arguments Type Intent Optional Attributes Name type(dual), intent(in), dimension(:) :: x Input values and derivative seeds; for seed vector , the\nreturned derivative is . class(*), intent(in), optional :: args Optional caller-owned context passed to the function.  It is\nread-only from the function's perspective. Return Value type(dual) Function value in f%x and directional derivative in f%dx . abstract interface public  subroutine vector_function(x, f, args) Evaluate a vector function on dual inputs; each output's dx is \nits directional derivative.\nProvides the dual-number input and output type. Arguments Type Intent Optional Attributes Name type(dual), intent(in), dimension(:) :: x Input values and derivative seeds; for seed vector , \noutputs propagate the direction . type(dual), intent(out), dimension(:) :: f Output values and derivatives; the derivatives form , where is the Jacobian. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure.  It is\nread-only from the procedure's perspective.","tags":"","url":"module\\autodiff_interfaces.html"},{"title":"autodiff_dual_numbers – AUTODIFF","text":"Forward-mode dual numbers and overloaded arithmetic and intrinsic operations.\nSupplies the real64 kind used for values and directional derivatives.\nDual-number value type; each instance stores a value and one directional derivative.\nAssignment conversions between dual numbers and real or integer scalars.\nArithmetic operators propagate derivatives using the corresponding calculus rules.\nEquality and ordering comparisons use values only and ignore derivative seeds.\nRemaining value-only ordering comparisons.\nOverloaded real-valued intrinsic functions with derivative propagation.\nAdditional inverse trigonometric, hyperbolic, and error functions.\nSelection and sign intrinsics propagate the derivative of the selected or magnitude operand. Uses iso_fortran_env Interfaces public        interface abs Absolute value; the derivative at zero is defined to be zero. private elemental function ad_abs(a) result(c) Propagate sign(a)*da, choosing derivative zero at a = 0. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. public        interface acos Inverse cosine in radians; the active derivative is singular at +/-1. private elemental function ad_acos(a) result(c) Propagate -da/sqrt(1-a**2) using the inverse-sine derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. public        interface acosh Inverse hyperbolic cosine for values >= 1; active derivative singular at 1. private elemental function ad_acosh(a) result(c) Propagate da/(sqrt(a-1)*sqrt(a+1)); inactive seeds stay zero at a = 1. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. public        interface asin Inverse sine in radians; the active derivative is singular at +/-1. private elemental function ad_asin(a) result(c) Propagate da/sqrt(1-a**2), omitting the singular term for inactive seeds. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. public        interface asinh Inverse hyperbolic sine. private elemental function ad_asinh(a) result(c) Propagate da/sqrt(a**2+1), using HYPOT to avoid overflow. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. public        interface assignment(=) Copy AD data, assign a constant (clearing dx), or extract a real value. private elemental subroutine ad_assign_1(lhs, rhs) Copy the value and derivative of rhs to lhs. Arguments Type Intent Optional Attributes Name type( dual ), intent(out) :: lhs Output dual value and derivative produced by this operation. type( dual ), intent(in) :: rhs Input dual operand; its value and derivative participate in the documented operation. private elemental subroutine ad_assign_2(lhs, rhs) Assign a real64 constant rhs to lhs and clear its derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(out) :: lhs Output dual value and derivative produced by this operation. real(kind=real64), intent(in) :: rhs Input scalar operand or parameter used by the documented operation. private elemental subroutine ad_assign_3(lhs, rhs) Extract the value of rhs into real64 lhs, discarding the derivative. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out) :: lhs Output scalar receiving the computed value. type( dual ), intent(in) :: rhs Input dual operand; its value and derivative participate in the documented operation. private elemental subroutine ad_assign_integer(lhs, rhs) Assign a default-integer constant rhs to lhs and clear its derivative. Arguments Type Intent Optional Attributes Name type( dual ), intent(out) :: lhs Output dual value and derivative produced by this operation. integer, intent(in) :: rhs Input scalar operand or parameter used by the documented operation. public        interface atan One- or two-argument inverse tangent in radians. private elemental function ad_atan(a) result(c) Propagate da/(1+a**2), using reciprocal scaling for large a. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: a Input dual operand; its value and derivative participate in the documented operation. Return Value type( dual ) Computed dual-number result containing a value and propagated derivative. private elemental function ad_atan2(y, x) result(c) Propagate (x dy-y dx)/(x 2+y 2) using normalized coordinates. Arguments Type Intent Optional Attributes Name type( dual ), intent(in) :: y Input dual operand; its value and derivative participate in the documented operation. type( dual ), intent(in) :: x Input dual operand; its value and derivative participate in the 