var tipuesearch = {"pages":[{"title":" AUTODIFF ","text":"AUTODIFF Developer Info Jason Christopherson","tags":"home","url":"index.html"},{"title":"hyperdual_workspace – AUTODIFF ","text":"type, public :: hyperdual_workspace Allocatable temporary arrays used during second-order automatic\ndifferentiation. Components Type Visibility Attributes Name Initial type( hyperdual ), public, allocatable, dimension(:,:) :: xd_pool Per-thread hyper-dual-valued input buffers, one column per\nthread.  Serial evaluations use the first column. Type-Bound Procedures procedure, public :: resize => hwrk_resize Allocates or grows the workspace buffers. private  subroutine hwrk_resize(work, n, nthreads) Allocates or grows the workspace buffers to at least the requested\ndimensions.  Buffers are never shrunk.  When growth is required, a\ndimension is sized to the larger of the request and twice its\nprevious size.  Buffer contents are not preserved on growth. Arguments Type Intent Optional Attributes Name class( hyperdual_workspace ), intent(inout) :: work Workspace whose input buffers are managed. integer, intent(in) :: n Required number of input elements per thread. integer, intent(in), optional :: nthreads Required number of per-thread buffer columns.  If omitted,\none column is required. procedure, public :: validate_size => hwrk_validate_size Validates the size of the workspace. private  function hwrk_validate_size(this, xd_size, nthreads) result(rst) Validates that the workspace arrays are allocated and at least\nthe size requested. Arguments Type Intent Optional Attributes Name class( hyperdual_workspace ), intent(in) :: this The hyperdual_workspace object. integer, intent(in) :: xd_size The desired minimum number of input elements per thread. integer, intent(in), optional :: nthreads The desired number of per-thread buffer columns.  If omitted,\none column is required. Return Value logical True if all buffers meet the minimum required size; else,\nfalse.","tags":"","url":"type\\hyperdual_workspace.html"},{"title":"workspace – AUTODIFF ","text":"type, public :: workspace Allocatable temporary arrays used during automatic differentiation. Components Type Visibility Attributes Name Initial type( dual ), public, allocatable, dimension(:) :: fd Dual-valued function output buffer. type( dual ), public, allocatable, dimension(:,:) :: fd_pool Per-thread dual-valued function output buffers, one column per thread. type( dual ), public, allocatable, dimension(:) :: xd Dual-valued input buffer. type( dual ), public, allocatable, dimension(:,:) :: xd_pool Per-thread dual-valued input buffers, one column per thread. Type-Bound Procedures procedure, public :: resize => wrk_resize Allocates or grows the workspace buffers. private  subroutine wrk_resize(work, n, m, nthreads) Allocates or grows the workspace buffers to at least the requested\ndimensions.  Buffers are never shrunk.  When growth is required, a\nbuffer is sized to the larger of the request and twice its\nprevious size.  Buffer contents are not preserved on growth. Arguments Type Intent Optional Attributes Name class( workspace ), intent(inout) :: work Workspace whose input and output buffers are managed. integer, intent(in) :: n Required number of input elements. integer, intent(in) :: m Required number of output elements. integer, intent(in), optional :: nthreads Required number of per-thread buffer columns.  If omitted,\none column is required. procedure, public :: validate_size => wrk_validate_size Validates the size of the workspace. private  function wrk_validate_size(this, xd_size, fd_size, nthreads) result(rst) Validates that the workspace arrays are allocated and at least\nthe size requested. Arguments Type Intent Optional Attributes Name class( workspace ), intent(in) :: this The workspace object. integer, intent(in) :: xd_size The desired minimum size of 'xd'. integer, intent(in) :: fd_size The desired minimum size of 'fd'. integer, intent(in), optional :: nthreads The desired number of per-thread buffer columns.  If omitted,\none column is required. Return Value logical True if all buffers meet the minimum required size; else,\nfalse.","tags":"","url":"type\\workspace.html"},{"title":"hyperdual – AUTODIFF ","text":"type, public :: hyperdual A value, two directional derivatives, and their mixed second derivative.\nSeed dx and dy with one for each independent variable under study\nand zero otherwise. Components Type Visibility Attributes Name Initial real(kind=real64), public :: dx First derivative with respect to the first seed. real(kind=real64), public :: dxy Mixed second derivative with respect to both seeds. real(kind=real64), public :: dy First derivative with respect to the second seed. real(kind=real64), public :: x Function or independent-variable value.","tags":"","url":"type\\hyperdual.html"},{"title":"dual – AUTODIFF ","text":"type, public :: dual A value and its directional derivative. Seed dx with one for an\nindependent variable and zero for constants. Components Type Visibility Attributes Name Initial real(kind=real64), public :: dx Directional derivative with respect to the current seed. real(kind=real64), public :: x Function or independent-variable value.","tags":"","url":"type\\dual.html"},{"title":"hyperdual_function – AUTODIFF","text":"interface public  function hyperdual_function(x, args) result(f) Arguments Type Intent Optional Attributes Name type(hyperdual), intent(in), dimension(:) :: x Input values and derivative seeds. class(*), intent(in), optional :: args Optional caller-owned context passed to the function.  It is\nread-only from the function's perspective. Return Value type(hyperdual) Function value and derivatives. Description Evaluate a scalar function on hyper-dual inputs; the result's dx , dy , and dxy carry the seeded first and mixed second derivatives.\nProvides the hyper-dual argument and result type.","tags":"","url":"interface\\hyperdual_function.html"},{"title":"scalar_function – AUTODIFF","text":"interface public  function scalar_function(x, args) result(f) Arguments Type Intent Optional Attributes Name type(dual), intent(in), dimension(:) :: x Input values and derivative seeds; for seed vector , the\nreturned derivative is . class(*), intent(in), optional :: args Optional caller-owned context passed to the function.  It is\nread-only from the function's perspective. Return Value type(dual) Function value in f%x and directional derivative in f%dx . Description Evaluate a scalar function on dual inputs; the result's dx is \nthe seeded directional derivative.\nProvides the dual-number argument and result type.","tags":"","url":"interface\\scalar_function.html"},{"title":"vector_function – AUTODIFF","text":"interface public  subroutine vector_function(x, f, args) Arguments Type Intent Optional Attributes Name type(dual), intent(in), dimension(:) :: x Input values and derivative seeds; for seed vector , \noutputs propagate the direction . type(dual), intent(out), dimension(:) :: f Output values and derivatives; the derivatives form , where is the Jacobian. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure.  It is\nread-only from the procedure's perspective. Description Evaluate a vector function on dual inputs; each output's dx is \nits directional derivative.\nProvides the dual-number input and output type.","tags":"","url":"interface\\vector_function.html"},{"title":"gradient – AUTODIFF","text":"public  subroutine gradient(fcn, x, g, work, args) Compute a scalar function's gradient by seeding one input direction \nat a time. Arguments Type Intent Optional Attributes Name procedure( scalar_function ) :: fcn User function whose result carries the value and seeded derivative. real(kind=real64), intent(in), dimension(:) :: x Point at which the gradient is evaluated. real(kind=real64), intent(out), dimension(:) :: g Gradient output, with one component per input; . class( workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure. Variables Type Visibility Attributes Name Initial type( dual ), public :: fd integer, public :: i integer, public :: j integer, public :: n type( dual ), public, allocatable, target, dimension(:) :: x_buffer type( dual ), public, pointer, dimension(:) :: xd","tags":"","url":"proc\\gradient.html"},{"title":"hessian – AUTODIFF","text":"public  subroutine hessian(fcn, x, H, g, f, work, args, nthreads) Compute a scalar function's Hessian, and optionally its gradient and\nvalue, by seeding hyper-dual inputs.  The Hessian is symmetric and\nrequires evaluations of fcn ; the gradient and value\nare taken from the diagonal evaluations at no additional cost. When 'nthreads' is greater than one and the library is built with\nOpenMP, the Hessian rows are evaluated in parallel.  In this case,\nthe user function must be thread-safe and must not modify shared\nstate through 'args' without synchronization. Arguments Type Intent Optional Attributes Name procedure( hyperdual_function ) :: fcn User function whose result carries the value and derivatives. real(kind=real64), intent(in), dimension(:) :: x Point at which the Hessian is evaluated. real(kind=real64), intent(out), dimension(:,:) :: H Hessian output, . real(kind=real64), intent(out), optional, dimension(:) :: g Optional gradient output, . real(kind=real64), intent(out), optional :: f Optional function value at x . class( hyperdual_workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the function. integer, intent(in), optional :: nthreads The maximum number of threads to use when evaluating the\nHessian rows.  The default is 1 (serial).","tags":"","url":"proc\\hessian.html"},{"title":"hvp – AUTODIFF","text":"public  subroutine hvp(fcn, x, v, Hv, work, args) Evaluate the product of a scalar function's Hessian and a vector\nwithout forming the Hessian.  Each evaluation seeds the first\nderivative direction with v and the second with a unit vector,\nso the mixed derivative yields one component of .  This\nrequires size(x) evaluations of fcn . Arguments Type Intent Optional Attributes Name procedure( hyperdual_function ) :: fcn User function whose result carries the value and derivatives. real(kind=real64), intent(in), dimension(:) :: x Point at which the Hessian is evaluated. real(kind=real64), intent(in), dimension(:) :: v Direction vector with one component per input. real(kind=real64), intent(out), dimension(:) :: Hv Product of the Hessian and v, satisfying . class( hyperdual_workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the function.","tags":"","url":"proc\\hvp.html"},{"title":"jvp – AUTODIFF","text":"public  subroutine jvp(fcn, x, v, Jv, work, args) Evaluate the directional derivative of a vector function without \nforming its Jacobian. Arguments Type Intent Optional Attributes Name procedure( vector_function ) :: fcn User procedure that evaluates the vector-valued function. real(kind=real64), intent(in) :: x (:) Input point at which the directional derivative is evaluated. real(kind=real64), intent(in), dimension(:) :: v Direction vector, with one component per input; its entries seed \neach dual input. real(kind=real64), intent(out), dimension(:) :: Jv Product of the Jacobian and v, satisfying . class( workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure. Variables Type Visibility Attributes Name Initial type( dual ), public, allocatable, target, dimension(:) :: f_buffer type( dual ), public, pointer, dimension(:) :: fd integer, public :: i integer, public :: m integer, public :: n type( dual ), public, allocatable, target, dimension(:) :: x_buffer type( dual ), public, pointer, dimension(:) :: xd","tags":"","url":"proc\\jvp.html"},{"title":"jacobian – AUTODIFF","text":"public  subroutine jacobian(fcn, x, J, work, args, nthreads) Compute a vector function's Jacobian by seeding each input basis \ndirection. When 'nthreads' is greater than one and the library is built with\nOpenMP, the Jacobian columns are evaluated in parallel.  In this\ncase, the user procedure must be thread-safe and must not modify\nshared state through 'args' without synchronization. Arguments Type Intent Optional Attributes Name procedure( vector_function ) :: fcn User procedure that evaluates the vector-valued function. real(kind=real64), intent(in), dimension(:) :: x Input point at which the Jacobian is evaluated. real(kind=real64), intent(out), dimension(:,:) :: J Jacobian output with shape (number of outputs, number of inputs); . class( workspace ), intent(inout), optional, target :: work An optional workspace to use in order to avoid internal memory\nallocations.  If not sized properly, this routine will grow\nthe workspace to suit its needs. class(*), intent(in), optional :: args Optional caller-owned context passed to the procedure. integer, intent(in), optional :: nthreads The maximum number of threads to use when evaluating the\nJacobian columns.  The default is 1 (serial). Variables Type Visibility Attributes Name Initial type( dual ), public, allocatable, target, dimension(:,:) :: f_buffer type( dual ), public, pointer, dimension(:,:) :: fd integer, public :: i integer, public :: k integer, public :: m integer, public :: n integer, public :: nt integer, public :: tid type( dual ), public, allocatable, target, dimension(:,:) :: x_buffer type( dual ), public, pointer, dimension(:,:) :: xd","tags":"","url":"proc\\jacobian.html"},{"title":"abs – AUTODIFF","text":"public interface abs Absolute value; the derivative at zero is taken as that of the positive branch. Module Procedures private pure function hd_abs(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\abs.html"},{"title":"acos – AUTODIFF","text":"public interface acos Inverse cosine function. Module Procedures private pure function hd_acos(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\acos.html"},{"title":"acosh – AUTODIFF","text":"public interface acosh Inverse hyperbolic cosine function. Module Procedures private pure function hd_acosh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\acosh.html"},{"title":"asin – AUTODIFF","text":"public interface asin Inverse sine function. Module Procedures private pure function hd_asin(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\asin.html"},{"title":"asinh – AUTODIFF","text":"public interface asinh Inverse hyperbolic sine function. Module Procedures private pure function hd_asinh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\asinh.html"},{"title":"assignment(=) – AUTODIFF","text":"public interface assignment(=) Copy hyper-dual data, assign a constant (clearing derivatives), or extract a real value. Module Procedures private pure subroutine hd_assign_hd(lhs, rhs) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(out) :: lhs type( hyperdual ), intent(in) :: rhs private pure subroutine hd_assign_real(lhs, rhs) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(out) :: lhs real(kind=real64), intent(in) :: rhs private pure subroutine hd_assign_integer(lhs, rhs) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(out) :: lhs integer, intent(in) :: rhs private pure subroutine real_assign_hd(lhs, rhs) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out) :: lhs type( hyperdual ), intent(in) :: rhs","tags":"","url":"interface\\assignment(=).html"},{"title":"atan – AUTODIFF","text":"public interface atan One- or two-argument inverse tangent function. Module Procedures private pure function hd_atan(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual ) private pure function hd_atan2(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual ) private pure function hd_atan2_real(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y real(kind=real64), intent(in) :: x Return Value type( hyperdual ) private pure function real_atan2_hd(y, x) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual )","tags":"","url":"interface\\atan.html"},{"title":"atan2 – AUTODIFF","text":"public interface atan2 Quadrant-aware inverse tangent with ordinate first. Module Procedures private pure function hd_atan2(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual ) private pure function hd_atan2_real(y, x) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: y real(kind=real64), intent(in) :: x Return Value type( hyperdual ) private pure function real_atan2_hd(y, x) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: y type( hyperdual ), intent(in) :: x Return Value type( hyperdual )","tags":"","url":"interface\\atan2.html"},{"title":"atanh – AUTODIFF","text":"public interface atanh Inverse hyperbolic tangent function. Module Procedures private pure function hd_atanh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\atanh.html"},{"title":"cos – AUTODIFF","text":"public interface cos Cosine function. Module Procedures private pure function hd_cos(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\cos.html"},{"title":"cosh – AUTODIFF","text":"public interface cosh Hyperbolic cosine function. Module Procedures private pure function hd_cosh(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\cosh.html"},{"title":"erf – AUTODIFF","text":"public interface erf Error function. Module Procedures private pure function hd_erf(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\erf.html"},{"title":"erfc – AUTODIFF","text":"public interface erfc Complementary error function. Module Procedures private pure function hd_erfc(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\erfc.html"},{"title":"exp – AUTODIFF","text":"public interface exp Exponential function. Module Procedures private pure function hd_exp(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\exp.html"},{"title":"log – AUTODIFF","text":"public interface log Natural logarithm of a positive value. Module Procedures private pure function hd_log(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\log.html"},{"title":"log10 – AUTODIFF","text":"public interface log10 Base-ten logarithm of a positive value. Module Procedures private pure function hd_log10(a) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a Return Value type( hyperdual )","tags":"","url":"interface\\log10.html"},{"title":"max – AUTODIFF","text":"public interface max Maximum, carrying the selected operand's derivatives; ties choose the first. Module Procedures private pure function hd_max(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_max_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_max_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual )","tags":"","url":"interface\\max.html"},{"title":"min – AUTODIFF","text":"public interface min Minimum, carrying the selected operand's derivatives; ties choose the first. Module Procedures private pure function hd_min(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_min_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_min_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual )","tags":"","url":"interface\\min.html"},{"title":"operator(*) – AUTODIFF","text":"public interface operator(*) Multiplication using the product rule to second order. Module Procedures private pure function hd_multiply(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_multiply_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_multiply_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_multiply_integer(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a integer, intent(in) :: b Return Value type( hyperdual ) private pure function integer_multiply_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name integer, intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual )","tags":"","url":"interface\\operator(ASTERISK).html"},{"title":"operator(**) – AUTODIFF","text":"public interface operator(**) Powers with constant or hyper-dual exponents.  A real or hyper-dual base\nraised to a non-integer power must be positive. Module Procedures private pure function hd_pow_integer(a, n) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a integer, intent(in) :: n Return Value type( hyperdual ) private pure function hd_pow_real(a, p) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: p Return Value type( hyperdual ) private pure function hd_pow_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function real_pow_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual )","tags":"","url":"interface\\operator(ASTERISKASTERISK).html"},{"title":"operator(+) – AUTODIFF","text":"public interface operator(+) Addition, including constant operands in either order. Module Procedures private pure function hd_add(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_add_real(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a real(kind=real64), intent(in) :: b Return Value type( hyperdual ) private pure function real_add_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual ) private pure function hd_add_integer(a, b) result(c) Arguments Type Intent Optional Attributes Name type( hyperdual ), intent(in) :: a integer, intent(in) :: b Return Value type( hyperdual ) private pure function integer_add_hd(a, b) result(c) Arguments Type Intent Optional Attributes Name integer, intent(in) :: a type( hyperdual ), intent(in) :: b Return Value type( hyperdual )","tags":"","url":"interface\\operator(+).html"},{"title":"operator(-) – AUTODIFF","text":"public interface operator(-) Subtraction and unary negation, including constant operands. Module Procedures