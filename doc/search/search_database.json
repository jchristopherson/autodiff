d0 / b % x ** 3 ) end function pure function hd_divide ( a , b ) result ( c ) type ( hyperdual ), intent ( in ) :: a , b type ( hyperdual ) :: c c = hd_multiply ( a , hd_reciprocal ( b )) end function pure function hd_divide_real ( a , b ) result ( c ) type ( hyperdual ), intent ( in ) :: a real ( real64 ), intent ( in ) :: b type ( hyperdual ) :: c c = hd_divide ( a , hd_const ( b )) end function pure function real_divide_hd ( a , b ) result ( c ) real ( real64 ), intent ( in ) :: a type ( hyperdual ), intent ( in ) :: b type ( hyperdual ) :: c c = hd_divide ( hd_const ( a ), b ) end function pure function hd_divide_integer ( a , b ) result ( c ) type ( hyperdual ), intent ( in ) :: a integer , intent ( in ) :: b type ( hyperdual ) :: c c = hd_divide ( a , hd_const ( real ( b , real64 ))) end function pure function integer_divide_hd ( a , b ) result ( c ) integer , intent ( in ) :: a type ( hyperdual ), intent ( in ) :: b type ( hyperdual ) :: c c = hd_divide ( hd_const ( real ( a , real64 )), b ) end function ! Powers. pure function hd_pow_integer ( a , n ) result ( c ) type ( hyperdual ), intent ( in ) :: a integer , intent ( in ) :: n type ( hyperdual ) :: c real ( real64 ) :: f1 , f2 f1 = 0.0d0 f2 = 0.0d0 if ( n /= 0 ) f1 = real ( n , real64 ) * a % x ** ( n - 1 ) if ( n /= 0 . and . n /= 1 ) f2 = real ( n * ( n - 1 ), real64 ) * a % x ** ( n - 2 ) c = hd_compose ( a , a % x ** n , f1 , f2 ) end function pure function hd_pow_real ( a , p ) result ( c ) type ( hyperdual ), intent ( in ) :: a real ( real64 ), intent ( in ) :: p type ( hyperdual ) :: c real ( real64 ) :: f1 , f2 f1 = 0.0d0 f2 = 0.0d0 if ( p /= 0.0d0 ) f1 = p * a % x ** ( p - 1.0d0 ) if ( p /= 0.0d0 . and . p /= 1.0d0 ) f2 = p * ( p - 1.0d0 ) * a % x ** ( p - 2.0d0 ) c = hd_compose ( a , a % x ** p , f1 , f2 ) end function pure function hd_pow_hd ( a , b ) result ( c ) type ( hyperdual ), intent ( in ) :: a , b type ( hyperdual ) :: c c = hd_exp ( hd_multiply ( b , hd_log ( a ))) end function pure 